spring.application.name=demo

# ===================================================================
# PLANTILLA DE CONFIGURACIÓN - SISTEMA EXPERTO DE RUTAS ACEROS AREQUIPA
# ===================================================================
# INSTRUCCIONES:
# 1. Copia este archivo y renómbralo como 'application.properties'
#    en esta misma carpeta (src/main/resources/).
# 2. Configura las variables de entorno o reemplaza los valores de ejemplo.
# 3. 'application.properties' está en .gitignore y NUNCA se sube a Git.
# ===================================================================

# Configuración de base de datos PostgreSQL / Supabase:
#   Opción Supabase (Nube):
#     DB_HOST: aws-0-us-east-1.pooler.supabase.com
#     DB_PORT: 5432
#     DB_NAME: postgres
#     DB_USERNAME: postgres.jtnhoreyccgyqxqrsqoo
#
#   Opción PostgreSQL Local:
#     DB_HOST: localhost
#     DB_PORT: 5433
#     DB_NAME: Aceros_Arequipa
#     DB_USERNAME: postgres
spring.datasource.url=jdbc:postgresql://${DB_HOST:aws-0-us-east-1.pooler.supabase.com}:${DB_PORT:5432}/${DB_NAME:postgres}?sslmode=require
spring.datasource.username=${DB_USERNAME:postgres.jtnhoreyccgyqxqrsqoo}
spring.datasource.password=${DB_PASSWORD:tu_password_aqui}
spring.datasource.driver-class-name=org.postgresql.Driver

# Configuración de JPA / Hibernate
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
