		"name": "Aceros Arequipa - Suite de Pruebas QA",
		"description": "Colección completa de pruebas de QA para la API REST del Sistema de Ruteo de Aceros Arequipa",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
