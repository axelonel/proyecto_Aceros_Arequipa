		{
			"name": "6. Optimizar Ruta con Google OR-Tools",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"origen\": \"A\",\n    \"destino\": \"F\",\n    \"material\": \"Bobinas de acero (24 Tn)\",\n    \"peso\": 24.0,\n    \"objetivo\": \"EQUILIBRIO\",\n    \"prioridad\": \"ALTA\",\n    \"evitarTrafico\": true,\n    \"evitarMantenimiento\": false\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/rutas/optimizar",
					"host": ["{{baseUrl}}"],
					"path": ["api", "rutas", "optimizar"]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Optimización exitosa con 200', function () { pm.response.to.have.status(200); });",
							"pm.test('Ruta óptima calculada', function () {",
							"    var data = pm.response.json();",
							"    pm.expect(data.exito).to.be.true;",
							"    pm.expect(data.distanciaKm).to.be.above(0);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			]
		},
