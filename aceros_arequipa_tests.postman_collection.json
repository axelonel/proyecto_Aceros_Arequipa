	"item": [
		{
			"name": "1. Health Check (Actuator)",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/actuator/health",
					"host": ["{{baseUrl}}"],
					"path": ["actuator", "health"]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code es 200', function () { pm.response.to.have.status(200); });",
							"pm.test('El sistema está UP', function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.status).to.eql('UP');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			]
		},
		{
			"name": "2. Iniciar Sesión (Admin)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"admin@acerosarequipa.com\",\n    \"password\": \"123456\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/auth/login",
					"host": ["{{baseUrl}}"],
					"path": ["api", "auth", "login"]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Login exitoso con 200', function () { pm.response.to.have.status(200); });",
							"pm.test('Token JWT generado', function () {",
							"    var data = pm.response.json();",
							"    pm.expect(data.token).to.not.be.empty;",
							"    pm.collectionVariables.set('token', data.token);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			]
		},
